# Development defaults, read automatically by `docker compose` from the repository root.
# Contains no secrets: these credentials only ever reach a container on your laptop.
# Machine-specific overrides belong in .env.local (git-ignored).

# Lets you run `docker compose up -d` from the repo root instead of passing -f twice.
# Drop the second path if your machine has no NVIDIA GPU (see docker/compose.gpu.yaml).
COMPOSE_FILE=docker/compose.yaml:docker/compose.gpu.yaml

POSTGRES_DB=llmgw
POSTGRES_USER=llmgw
POSTGRES_PASSWORD=llmgw
POSTGRES_PORT=5432

REDIS_PORT=6379

OLLAMA_PRIMARY_PORT=11434
OLLAMA_SECONDARY_PORT=11435

GATEWAY_PORT=8080
